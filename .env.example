# Copy this file to .env. Without BOTH AI_API_KEY and AI_MODEL, the app uses
# the explicitly labelled local rule-based demo. Never put secrets in VITE_*.
AI_API_KEY=
AI_MODEL=deepseek-flash
# The /chat/completions path is added by the server.
AI_BASE_URL=https://api.deepseek.com
AI_THINKING=disabled
# Keep 8787 for npm run dev; vite.config.js proxies to this port.
PORT=8787
# Set these for a reverse-proxied deployment; leave empty for local development.
ALLOWED_ORIGINS=
DATA_DIRECTORY=
